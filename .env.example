# Create a private key in Google AI Studio and set it locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional: free-tier backup from https://console.groq.com/
# If both keys are set and LLM_PROVIDER=auto, Groq is tried first.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=auto
