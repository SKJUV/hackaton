# ===== IA (toutes optionnelles : sans clé, l'app tourne en MODE DÉMO) =====
# Clé privée Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Clé gratuite https://console.groq.com/ (essayée en premier si LLM_PROVIDER=auto)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Tout fournisseur compatible OpenAI (OpenAI, OpenRouter, Mistral, serveur local…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# auto | groq | gemini | openai | demo  (chat juridique + agent)
LLM_PROVIDER=auto
# Optionnel : forcer un fournisseur différent pour l'agent uniquement
AGENT_PROVIDER=

# ===== Emails =====
# simulation (défaut) : AUCUN envoi réel, l'email apparaît « simulé » dans la boîte d'envoi
# live : envoi réel après validation humaine, via MAIL_PROVIDER
MAIL_MODE=simulation
MAIL_PROVIDER=resend
MAIL_FROM=Co-fondateur IA <no-reply@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ===== Données =====
# Chemin de la base JSON du workspace (défaut : data/workspace.db.json)
WORKSPACE_DB_PATH=

# ===== Comptes / sessions =====
# Secret de signature des cookies de session (OBLIGATOIRE en production ; défaut de dev sinon)
AUTH_SECRET=
# URL publique (liens magiques, retours de paiement) ; déduite de la requête sinon
APP_URL=
# true pour tester `next start` en http local (cookie non Secure) ; jamais en production
AUTH_INSECURE_COOKIE=

# ===== Abonnement =====
# on (défaut) : l'assistant co-fondateur est réservé aux abonnés ; off : ouvert à tous (dev)
BILLING_PAYWALL=on
# Prix en FCFA (sinon prix d'EXEMPLE : 9 900 et 29 900)
PRICE_COFONDATEUR_XAF=
PRICE_EQUIPE_XAF=
# simulation (défaut) | cinetpay | notchpay | stripe
PAYMENT_PROVIDER=simulation
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Module memoire (mémoire, réunions, Score Co-founder, bas débit) =====
# Clé privée Ed25519 (PKCS#8 PEM, « \n » échappés acceptés, ou base64) qui signe les attestations du Score.
# Vide : clé de développement générée dans data/score-signing-key.dev.pem (attestations marquées « démo »).
# Générer : node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
COFOUNDER_SCORE_SIGNING_KEY=
# Identifiants (keyId) d'anciennes clés encore acceptées après rotation, séparés par des virgules
COFOUNDER_SCORE_TRUSTED_KEY_IDS=
# Chemin de la clé de développement (défaut : à côté de la base JSON)
COFOUNDER_SCORE_KEY_FILE=
# Transcription audio des réunions : auto (Groq puis OpenAI) | groq | openai | demo
TRANSCRIPTION_PROVIDER=auto
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
OPENAI_TRANSCRIBE_MODEL=whisper-1
